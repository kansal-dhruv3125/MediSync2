# Copy this file to .env and fill in real values. NEVER commit the real .env.

PORT=5000
NODE_ENV=development

# Paste your real MongoDB URI here; leave blank until you have it.
# Use the existing cluster and include /medisync before any query options.
# URL-encode special characters in the username/password (@ : / ? # [ ] %).
MONGODB_URI=

# Generate a local secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS, e.g.:
#   http://localhost:8080,https://medisync2.onrender.com
CLIENT_URL=http://localhost:8080
