# Copy this file to .env and fill in real values. NEVER commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Atlas UI -> Cluster -> Connect -> Drivers -> copy the SRV string.
# - Include the database name medisync before the "?".
# - URL-encode the password if it contains special characters (@ : / ? # [ ] %).
#   Example encoding: @ -> %40 , : -> %3A
# Use your own cluster host — do not share connection strings publicly.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/medisync

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS, e.g.:
#   http://localhost:3000,https://medisync2-frontend.onrender.com
CLIENT_URL=
